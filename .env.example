# Azure OpenAI natural-language SQL generation
AZURE_OPENAI_ENDPOINT=https://azopenai-bank-hub.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=your-api-version
AZURE_OPENAI_API_KEY=replace-locally-do-not-share

# Optional. Required for recorded audio transcription; deploy Azure OpenAI Whisper first.
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=your-whisper-deployment-name

# Existing MySQL configuration is required in .env
# Optional. Defaults to abc; choose employee_db or both to use another source.
CHATBOT_DATABASE=abc

# Optional. Used to email generated PDF reports via SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-address@gmail.com
